# RibOS Windows-style keyboard shortcuts (copied to every new user's home).
# Super alone opens the start menu: see /etc/xdg/kwinrc [ModifierOnlyShortcuts].
# Alt+Tab (switch windows), Super+L (lock) and Super+arrows (snap) are Plasma
# defaults and are repeated here so they are easy to find and change.

[services][org.kde.dolphin.desktop]
_launch=Meta+E

[services][org.kde.plasma-systemmonitor.desktop]
_launch=Ctrl+Shift+Esc\tCtrl+Esc

[services][org.kde.spectacle.desktop]
_launch=Print

[services][systemsettings.desktop]
_launch=Meta+I

[services][org.kde.konsole.desktop]
_launch=Ctrl+Alt+T

[kwin]
Show Desktop=Meta+D,Meta+D,Peek at Desktop
Walk Through Windows=Alt+Tab,Alt+Tab,Walk Through Windows
Window Quick Tile Left=Meta+Left,Meta+Left,Quick Tile Window to the Left
Window Quick Tile Right=Meta+Right,Meta+Right,Quick Tile Window to the Right
# Super+Up maximizes and Super+Down minimizes, like Windows (instead of
# Plasma's default of tiling to the top/bottom half).
Window Quick Tile Top=none,Meta+Up,Quick Tile Window to the Top
Window Quick Tile Bottom=none,Meta+Down,Quick Tile Window to the Bottom
Window Maximize=Meta+Up\tMeta+PgUp,Meta+PgUp,Maximize Window
Window Minimize=Meta+Down\tMeta+PgDown,Meta+PgDown,Minimize Window

[ksmserver]
Lock Session=Meta+L\tScreensaver,Meta+L\tScreensaver,Lock Session
