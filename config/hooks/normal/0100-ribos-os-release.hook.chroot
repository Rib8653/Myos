#!/bin/sh
# Brand the system as RibOS in /etc/os-release (read by GRUB, System Settings'
# "About this system", neofetch, Calamares, ...).
# Debian's base-files owns /usr/lib/os-release; divert it so package upgrades
# don't put the Debian text back.
set -e

for f in /usr/lib/os-release /etc/issue /etc/issue.net; do
	[ -e "$f.debian" ] || cp -a "$f" "$f.debian"
	dpkg-divert --quiet --local --no-rename --add --divert "$f.debian" "$f"
done

. /usr/lib/os-release.debian   # for VERSION_ID / VERSION_CODENAME of the Debian base

cat > /usr/lib/os-release <<EOT
PRETTY_NAME="RibOS 1.0 (Debian ${VERSION_ID} based)"
NAME="RibOS"
VERSION_ID="1.0"
VERSION="1.0 (${VERSION_CODENAME})"
VERSION_CODENAME=${VERSION_CODENAME}
DEBIAN_VERSION_ID="${VERSION_ID}"
ID=ribos
ID_LIKE=debian
LOGO=ribos-logo
ANSI_COLOR="1;34"
HOME_URL="https://github.com/rib8653/myos"
SUPPORT_URL="https://github.com/rib8653/myos/issues"
BUG_REPORT_URL="https://github.com/rib8653/myos/issues"
EOT
ln -sf ../usr/lib/os-release /etc/os-release

echo 'RibOS 1.0 \n \l' > /etc/issue
echo 'RibOS 1.0' > /etc/issue.net
