<?xml version="1.0" encoding="UTF-8"?>
<!-- RibOS LibreOffice defaults: the Colibre icon style, which suits the
     Windows-style desktop. Users can still change it under
     Tools > Options > View. -->
<oor:data xmlns:xs="http://www.w3.org/2001/XMLSchema"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns:oor="http://openoffice.org/2001/registry">
  <oor:component-data oor:name="Common" oor:package="org.openoffice.Office">
    <node oor:name="Misc">
      <prop oor:name="SymbolStyle" oor:op="fuse">
        <value>colibre</value>
      </prop>
    </node>
  </oor:component-data>
</oor:data>
