#!/bin/sh
# Set the apps pinned in the RibOS start menu for new users.
#
# Kickoff copies its *built-in* default favourites into KDE's activity
# database the moment it is created, before a layout script can change its
# settings. So RibOS edits that built-in default instead. This runs at image
# build time and again after every apt run (see
# /etc/apt/apt.conf.d/99ribos-start-menu-pins) so Plasma updates keep it.
#
# Edit PINS to change the pinned apps (comma separated .desktop file names;
# preferred://browser = the default web browser).
PINS="preferred://browser,org.kde.dolphin.desktop,libreoffice-writer.desktop,libreoffice-calc.desktop,libreoffice-impress.desktop,vlc.desktop,org.kde.gwenview.desktop,org.kde.kate.desktop,org.kde.discover.desktop,systemsettings.desktop,org.kde.konsole.desktop,ribos-dark-mode.desktop"

F=/usr/share/plasma/plasmoids/org.kde.plasma.kickoff/contents/config/main.xml
[ -f "$F" ] || exit 0
grep -q "<default>$PINS</default>" "$F" && exit 0
sed -i "/<entry name=\"favorites\"/,/<\/entry>/ s|<default>.*</default>|<default>$PINS</default>|" "$F"
