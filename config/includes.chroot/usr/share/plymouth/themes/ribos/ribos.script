# RibOS Plymouth splash: dark gradient, centered logo, thin progress bar,
# password prompt for encrypted disks.

Window.SetBackgroundTopColor(0.043, 0.063, 0.141);     # #0B1024
Window.SetBackgroundBottomColor(0.118, 0.106, 0.294);  # #1E1B4B

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2;
logo.y = Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 40;
logo.sprite.SetPosition(logo.x, logo.y, 10);

# Progress bar: a track and a bouncing segment drawn from solid-colour images.
bar.width = 240;
bar.height = 4;
bar.x = Window.GetX() + Window.GetWidth() / 2 - bar.width / 2;
bar.y = logo.y + logo.image.GetHeight() + 50;
track.image = Image("track.png").Scale(bar.width, bar.height);
track.sprite = Sprite(track.image);
track.sprite.SetPosition(bar.x, bar.y, 10);
seg.image = Image("segment.png").Scale(bar.width / 4, bar.height);
seg.sprite = Sprite(seg.image);
seg.sprite.SetPosition(bar.x, bar.y, 11);

t = 0;
fun refresh_callback() {
    t++;
    pos = (Math.Sin(t / 30) + 1) / 2;      # 0..1, smooth back and forth
    seg.sprite.SetX(bar.x + pos * (bar.width - bar.width / 4));
}
Plymouth.SetRefreshFunction(refresh_callback);

# Disk-encryption password prompt.
prompt.sprite = Sprite();
bullets.sprite = Sprite();
fun display_password_callback(prompt_text, bullet_count) {
    prompt.sprite.SetImage(Image.Text(prompt_text, 1, 1, 1));
    prompt.sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - prompt.sprite.GetImage().GetWidth() / 2, bar.y + 30, 20);
    s = "";
    for (i = 0; i < bullet_count; i++) s += "●";
    bullets.sprite.SetImage(Image.Text(s, 1, 1, 1));
    bullets.sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - bullets.sprite.GetImage().GetWidth() / 2, bar.y + 60, 20);
    seg.sprite.SetOpacity(0);
}
fun display_normal_callback() {
    prompt.sprite.SetOpacity(0);
    bullets.sprite.SetOpacity(0);
    seg.sprite.SetOpacity(1);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);

# Messages (e.g. fsck progress) at the bottom.
msg.sprite = Sprite();
fun message_callback(text) {
    msg.sprite.SetImage(Image.Text(text, 0.7, 0.7, 0.8));
    msg.sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - msg.sprite.GetImage().GetWidth() / 2, Window.GetY() + Window.GetHeight() - 60, 20);
}
Plymouth.SetMessageFunction(message_callback);
