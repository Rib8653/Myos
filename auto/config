#!/bin/sh
# RibOS live-build configuration.
# This script is run by `lb config`. Edit the options here rather than the
# generated files under config/ (config/common, config/binary, ... are
# regenerated from this script on every build and are git-ignored).
set -e

# Target architecture: amd64 (default, Intel/AMD PCs) or arm64 (e.g. Apple
# Silicon Macs in UTM, Arm laptops/servers). Set by build.sh --arch.
ARCH="${RIBOS_ARCH:-amd64}"
case "${ARCH}" in
	amd64) BOOTLOADERS="grub-efi,syslinux" ;;   # UEFI + legacy BIOS
	arm64) BOOTLOADERS="grub-efi" ;;            # Arm machines are UEFI-only
	*) echo "Unsupported RIBOS_ARCH: ${ARCH} (use amd64 or arm64)" >&2; exit 1 ;;
esac

# Building for another architecture than the host's (e.g. arm64 on a PC)
# runs the target's programs through QEMU user-mode emulation. Slow, but works.
HOST_ARCH="$(dpkg --print-architecture)"
CROSS=""
if [ "${ARCH}" != "${HOST_ARCH}" ]; then
	case "${ARCH}" in
		arm64) QEMU=qemu-aarch64-static ;;
		amd64) QEMU=qemu-x86_64-static ;;
	esac
	CROSS="--bootstrap-qemu-arch ${ARCH} --bootstrap-qemu-static /usr/bin/${QEMU}"
fi

lb config noauto \
	--mode debian \
	--distribution trixie \
	--architectures "${ARCH}" \
	--linux-flavours "${ARCH}" \
	--archive-areas "main contrib non-free non-free-firmware" \
	\
	`# HTTPS mirrors (work through HTTPS-only proxies too)` \
	--mirror-bootstrap "https://deb.debian.org/debian/" \
	--mirror-chroot "https://deb.debian.org/debian/" \
	--mirror-chroot-security "https://security.debian.org/debian-security/" \
	--mirror-binary "https://deb.debian.org/debian/" \
	--mirror-binary-security "https://security.debian.org/debian-security/" \
	--security true \
	--updates true \
	\
	`# Hybrid ISO: boots from DVD or USB; UEFI via GRUB, legacy BIOS via isolinux (amd64)` \
	--binary-images iso-hybrid \
	--bootloaders "${BOOTLOADERS}" \
	--debian-installer none \
	\
	`# Firmware: installed from config/package-lists/firmware.list.chroot instead` \
	--firmware-chroot false \
	--firmware-binary false \
	\
	--iso-application "RibOS" \
	--iso-publisher "RibOS project" \
	--iso-volume "RibOS" \
	--image-name "ribos" \
	\
	--bootappend-live "boot=live components quiet splash username=ribos user-fullname=RibOS hostname=ribos locales=en_US.UTF-8 keyboard-layouts=us" \
	--apt-recommends true \
	--cache true \
	${CROSS} \
	"${@}"
